{
  "name": "urk-examples",
  "version": "0.1.0",
  "description": "URK examples workspace - repo-only proofs demonstrating kernel usage",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "corepack yarn workspace @urk/react-urk build && node --test tests/*.test.mjs",
    "lint": "tsc --noEmit",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@urk/adapters": "workspace:*",
    "@urk/core": "workspace:*",
    "@urk/examples": "workspace:*",
    "@urk/react-urk": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
