{
  "name": "@urk/player-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Desktop host for compiled uRK portable experiences",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "electron .",
    "package": "node scripts/package.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@urk/cli": "workspace:*",
    "@urk/player": "workspace:*"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^20.17.57",
    "electron": "44.9.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
