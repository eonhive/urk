---
/**
 * Company: EonHive Inc.
 * Title: Landing Page
 * Purpose: Present the public URK landing page with runtime-kernel messaging, public package truth, and live-surface previews.
 * Author: Stan Nesi
 * Created: 2026-05-01
 * Updated: 2026-10-11
 * Notes: Vibe coded with Codex.
 */

import BaseLayout from '@/components/layout/BaseLayout.astro';
import CodeBlock from '@/components/docs/CodeBlock.astro';
import { siteMetadata } from '@/data/site';
import '@/styles/home.css';

const capabilities = [
  { icon: 'runtime-kernel', title: 'Small core', detail: 'One clear lifecycle', href: '/docs/concepts/runtime-kernel/' },
  { icon: 'package', title: 'Modular by design', detail: 'Use only what you need', href: '/packages/' },
  { icon: 'browser-surface', title: 'Web + 3D', detail: 'Connect scenes and UI', href: '/playground/' },
  { icon: 'controller', title: 'Your framework', detail: 'Standalone, React, Next', href: '/docs/concepts/integration-wrappers/' },
  { icon: 'event-bus', title: 'Made to interact', detail: 'Input, audio, and events', href: '/examples/' },
];
const code = `import { createKernel } from '@urk/core';
import { createInputAdapter, InputCapability }
  from '@urk/adapters/input';

const runtime = createKernel({
  frameMode: 'auto',
  adapters: [createInputAdapter()],
  controllers: [{
    id: 'experience',
    start(ctx) {
      const input = ctx.require(InputCapability);
      ctx.scope.defer(input.bindKey({
        code: 'Space',
        handler: () => console.log('Make something happen.'),
      }));
    },
  }],
});

await runtime.boot();
// When your experience leaves the page:
// await runtime.shutdown();`;
---

<BaseLayout title={siteMetadata.title} description={siteMetadata.description}>
  <section class="home-hero site-shell">
    <div class="home-hero__copy">
      <a class="release-chip" href="/docs/guides/urk-v02/"><span></span> Meet URK v0.2 <span aria-hidden="true">↗</span></a>
      <h1>A tiny runtime.<br /><span class="gradient-text">Big possibilities.</span></h1>
      <p class="home-hero__lead">Build interactive experiences.</p>
      <p class="home-hero__description">Bring 3D, sound, input, and UI together with one small, modular runtime. Your ideas. Your tools. Your next creation.</p>
      <div class="home-actions">
        <a class="site-button site-button--primary" href="/playground/">Open playground <span aria-hidden="true">↗</span></a>
        <a class="site-button site-button--secondary" href={siteMetadata.githubUrl} target="_blank" rel="noreferrer">View on GitHub <span aria-hidden="true">↗</span></a>
      </div>
      <div class="home-trust"><span>Open source</span><span>TypeScript</span><span>Framework independent</span></div>
    </div>
    <div class="home-world">
      <img src="/brand/art/runtime-world.webp" width="1024" height="1024" alt="An imagined creative world: a miniature studio and garden on connected glass platforms." fetchpriority="high" />
      <span class="world-label world-label--top"><i></i> Your ideas, connected</span>
      <span class="world-label world-label--bottom">3D · Audio · Input · UI</span>
      <span class="world-coordinate" aria-hidden="true">CREATE / COMBINE / EXTEND</span>
    </div>
  </section>

  <nav class="capability-strip site-shell" aria-label="Explore URK capabilities">
    {capabilities.map(item => <a href={item.href}>
      <img src={`/brand/icons/${item.icon}.svg`} width="32" height="32" alt="" />
      <strong>{item.title}</strong><span>{item.detail}</span>
    </a>)}
  </nav>

  <section class="home-section site-shell" aria-labelledby="action-title">
    <div class="home-section__heading"><div><span class="home-eyebrow">IDEAS INTO INTERACTION</span><h2 id="action-title">Less setup. More possibility.</h2></div><a class="text-link" href="/examples/">Explore the examples <span aria-hidden="true">↗</span></a></div>
    <div class="home-build-grid">
      <article class="home-playground-card">
        <div class="home-panel-top"><span><i class="status-dot"></i> URK PLAYGROUND</span><span>v0.2</span></div>
        <div class="home-shapes" aria-hidden="true">
          <div class="preview-shape preview-shape--sphere"></div><div class="preview-shape preview-shape--cube"></div><div class="preview-shape preview-shape--ring"></div>
          <span>EXPLORE</span><span>CREATE</span><span>CONNECT</span>
        </div>
        <div class="home-playground-card__copy"><span class="home-eyebrow">TRY IT IN YOUR BROWSER</span><h3>One experience.<br />Everything connected.</h3><p>Pick an object. Rotate it. Add a little sound. See how URK brings the pieces together.</p><a class="site-button site-button--primary" href="/playground/">Run the live playground <span aria-hidden="true">↗</span></a></div>
        <div class="home-panel-bottom"><span>Three.js + pointer + keyboard + audio</span><span>Rests while idle</span></div>
      </article>
      <div class="home-code"><CodeBlock title="experience.ts · v0.2 API" language="typescript" code={code} /><div class="home-code__footer"><span>Explicit startup. Owned resources. Clean shutdown.</span><a class="text-link" href="/docs/guides/urk-v02/">Read the guide ↗</a></div></div>
    </div>
  </section>

  <section class="home-section home-about site-shell" aria-labelledby="about-title">
    <div><span class="home-eyebrow">SMALL CORE. CLEAR BOUNDARIES.</span><h2 id="about-title">What is URK?</h2><p>URK is a public open-source runtime kernel for interactive browser experiences. It handles the lifecycle and connects capabilities, so your controllers can focus on the experience.</p><a class="text-link" href="/docs/introduction/what-is-urk/">Get to know the runtime ↗</a></div>
    <div class="home-principles">
      <article><span class="principle-number">01</span><h3>Create</h3><p>Start with a kernel and a controller. Make your first interaction.</p></article>
      <article><span class="principle-number">02</span><h3>Combine</h3><p>Add the capabilities you need. Connect them through typed contracts.</p></article>
      <article><span class="principle-number">03</span><h3>Extend</h3><p>Bring your own adapters. Run standalone, inside React, or with Next.</p></article>
    </div>
  </section>

  <section class="home-cta site-shell"><div><span class="home-eyebrow">YOUR NEXT IDEA STARTS HERE</span><h2>Make something interactive.</h2><p>Explore the runtime, borrow an example, and make it yours.</p></div><a class="site-button site-button--primary" href="/docs/getting-started/">Start building <span aria-hidden="true">↗</span></a></section>
</BaseLayout>
