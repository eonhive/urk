---
/**
 * Company: EonHive Inc.
 * Title: Audio Lab Surface
 * Purpose: Present an accessible visual deck for the public audio runtime proof.
 * Author: Stan Nesi
 * Created: 2026-09-21
 * Updated: 2026-09-21
 * Notes: Vibe coded with Codex.
 */

const tracks = [
  { id: 'bed', label: 'Ambient bed', note: 'A low, continuous loop', loop: true },
  { id: 'pulse', label: 'Pulse cue', note: 'A short rhythmic signal', loop: false },
  { id: 'confirm', label: 'Confirmation', note: 'A quick resolving tone', loop: false },
];
---

<section class="audio-lab" data-role="audio-surface" data-playing="false" data-muted="false" aria-label="Audio Lab">
  <div class="audio-lab__art" aria-hidden="true">
    <span class="audio-lab__edition">URK / SOUND STUDIES / 001</span>
    <div class="audio-lab__record"><div class="audio-lab__label">uRK<span>AUDIO LAB</span></div></div>
    <div class="audio-lab__caption"><span>Browser audio</span><span>Controller driven</span></div>
  </div>
  <div class="audio-lab__deck">
    <div class="audio-lab__heading">
      <span class="site-kicker">Listen to the runtime</span>
      <span class="audio-lab__status" data-role="audio-status" role="status">Preparing</span>
    </div>
    <h2 data-role="audio-title">Ambient bed</h2>
    <p class="audio-lab__intro">Pick a sound. Change the volume. Pause the runtime and hear the whole experience stop.</p>
    <div class="audio-lab__tracks" role="group" aria-label="Choose and play a sound">
      {tracks.map((track, index) => (
        <button type="button" class="audio-lab__track" disabled
          data-track-id={track.id} data-track-label={track.label}
          data-track-src={`/audio/${track.id}.wav`} data-track-loop={String(track.loop)}
          aria-pressed={index === 0}>
          <span class="audio-lab__number">0{index + 1}</span>
          <span><strong>{track.label}</strong><small>{track.note}</small></span>
          <span class="audio-lab__track-mark" aria-hidden="true">&#9654;</span>
        </button>
      ))}
    </div>
    <div class="audio-lab__transport" role="group" aria-label="Audio transport">
      <button class="site-button audio-lab__play" type="button" data-role="audio-play" disabled>Play track</button>
      <button class="site-button site-button--secondary" type="button" data-role="audio-stop" disabled>Stop</button>
      <button class="site-button site-button--secondary" type="button" data-role="audio-mute" aria-pressed="false" disabled>Mute</button>
    </div>
    <label class="audio-lab__volume">
      <span>Volume <output data-role="audio-volume-value">35%</output></span>
      <input type="range" min="0" max="1" step="0.05" value="0.35" data-role="audio-volume" disabled />
    </label>
    <p class="audio-lab__message" data-role="audio-message" role="status">Preparing the runtime. Sound starts only after you press Play.</p>
    <p class="audio-lab__note">Record motion reflects playback state, not an audio analysis. Reduced motion is respected.</p>
    <noscript>Enable JavaScript to try the audio deck. The guide and source below remain available.</noscript>
  </div>
</section>

<style>
  .audio-lab {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    overflow: hidden;
    border: 1px solid var(--urk-border-strong);
    border-radius: var(--urk-radius-lg);
    background: var(--urk-surface);
  }
  .audio-lab__art {
    position: relative;
    display: grid;
    min-height: 34rem;
    align-content: center;
    padding: 2.5rem;
    overflow: hidden;
    color: #102e32;
    background:
      radial-gradient(ellipse at 20% 15%, #daf4c9, transparent 65%),
      linear-gradient(145deg, #acd4b6, #55b9ac);
  }
  .audio-lab__edition {
    position: absolute;
    top: 2rem;
    left: 2rem;
    font: 0.7rem var(--urk-font-code);
    letter-spacing: 0.12em;
  }
  .audio-lab__record {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: repeating-radial-gradient(
      circle,
      #132426 0 2px,
      #273b3d 3px,
      #102122 4px 7px
    );
    box-shadow: 0 24px 50px #173e3d55;
    animation: audio-record-spin 12s linear infinite paused;
  }
  .audio-lab__label {
    display: grid;
    place-content: center;
    width: 37%;
    aspect-ratio: 1;
    border: 8px solid #102122;
    border-radius: 50%;
    text-align: center;
    color: #202b2a;
    background: #ef956e;
    font: 600 clamp(2rem, 4vw, 3.5rem) var(--urk-font-display);
  }
  .audio-lab__label span {
    font: 0.55rem var(--urk-font-code);
    letter-spacing: 0.12em;
  }
  .audio-lab__caption {
    position: absolute;
    left: 2rem;
    right: 2rem;
    bottom: 2rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font: 0.7rem var(--urk-font-code);
    text-transform: uppercase;
  }
  .audio-lab[data-playing="true"] .audio-lab__record {
    animation-play-state: running;
  }
  .audio-lab[data-muted="true"] .audio-lab__label {
    background: #bbc7bf;
  }
  .audio-lab__deck {
    display: grid;
    align-content: center;
    gap: 1.2rem;
    padding: clamp(1.2rem, 3vw, 2.5rem);
  }
  .audio-lab__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
  }
  .audio-lab__status {
    font: 0.75rem var(--urk-font-code);
    color: var(--urk-foreground);
  }
  .audio-lab h2 {
    margin: 0;
    font: 600 clamp(2rem, 3vw, 3rem)/1.1 var(--urk-font-display);
    letter-spacing: -0.04em;
  }
  .audio-lab__intro,
  .audio-lab__message {
    margin: 0;
    color: var(--urk-muted);
    line-height: 1.65;
    font-size: 0.95rem;
  }
  .audio-lab__tracks {
    display: grid;
    gap: 0.5rem;
  }
  .audio-lab__track {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    align-items: center;
    gap: 0.75rem;
    min-height: 4.5rem;
    padding: 0.85rem;
    border: 1px solid var(--urk-border);
    border-radius: 0.7rem;
    text-align: left;
    color: var(--urk-foreground);
    background: var(--urk-background);
    cursor: pointer;
  }
  .audio-lab__track[aria-pressed="true"] {
    border-color: var(--urk-success);
    background: color-mix(in srgb, var(--urk-success) 9%, var(--urk-background));
  }
  .audio-lab__number {
    font: 0.8rem var(--urk-font-code);
    color: var(--urk-muted);
  }
  .audio-lab__track strong,
  .audio-lab__track small {
    display: block;
  }
  .audio-lab__track small {
    margin-top: 0.3rem;
    color: var(--urk-muted);
    font-size: 0.75rem;
  }
  .audio-lab__track-mark {
    font-size: 0.8rem;
  }
  .audio-lab__transport {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
  .audio-lab__play {
    flex: 1;
    color: #202b2a;
    background: #ef956e;
  }
  .audio-lab__volume {
    display: grid;
    gap: 0.4rem;
    font: 0.8rem var(--urk-font-code);
  }
  .audio-lab__volume span {
    display: flex;
    justify-content: space-between;
  }
  .audio-lab__volume input {
    width: 100%;
    min-height: 2.75rem;
    accent-color: var(--urk-success);
  }
  .audio-lab__message {
    min-height: 3.2em;
  }
  .audio-lab__note {
    margin: 0;
    font-size: 0.72rem;
    line-height: 1.6;
    color: var(--urk-muted);
  }
  .audio-lab button:disabled {
    opacity: 0.55;
    cursor: default;
  }
  @keyframes audio-record-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .audio-lab__record {
      animation: none;
    }
  }
  @media (max-width: 760px) {
    .audio-lab {
      grid-template-columns: minmax(0, 1fr);
    }
    .audio-lab__art {
      min-height: 22rem;
      padding: 4rem;
    }
    .audio-lab__record {
      max-width: 20rem;
      justify-self: center;
    }
    .audio-lab__edition {
      top: 1.3rem;
      left: 1.3rem;
    }
    .audio-lab__caption {
      bottom: 1.3rem;
      left: 1.3rem;
      right: 1.3rem;
    }
  }
</style>
