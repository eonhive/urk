{
  "name": "@urk/player",
  "version": "0.2.0",
  "description": "Optional iframe-based Web Component for hosting exported uRK experiences",
  "type": "module",
  "main": "./dist/urk-player.js",
  "module": "./dist/urk-player.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/urk-player.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
