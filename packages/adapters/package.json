{
  "name": "@urk/adapters",
  "version": "0.2.0",
  "description": "URK adapters - reference three, pointer, input, loading, storage, and overlay capability adapters",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dom": {
      "import": "./dist/dom.js",
      "types": "./dist/dom.d.ts"
    },
    "./audio": {
      "types": "./dist/audio/index.d.ts",
      "import": "./dist/audio/index.js"
    },
    "./input": {
      "types": "./dist/input/index.d.ts",
      "import": "./dist/input/index.js"
    },
    "./loading": {
      "types": "./dist/loading/index.d.ts",
      "import": "./dist/loading/index.js"
    },
    "./pointer": {
      "types": "./dist/pointer/index.d.ts",
      "import": "./dist/pointer/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "import": "./dist/three/index.js"
    },
    "./ui-widgets": {
      "types": "./dist/ui-widgets/index.d.ts",
      "import": "./dist/ui-widgets/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "test": "yarn build && yarn test:types && node --test tests/*.test.mjs",
    "lint": "yarn typecheck",
    "test:types": "tsc --project tests/types/tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@urk/core": "^0.2.0",
    "three": "^0.184.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/three": "^0.184.0",
    "@urk/core": "^0.2.0",
    "three": "^0.184.0",
    "typescript": "^5.3.0"
  }
}
