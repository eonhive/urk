{
  "name": "@urk/core",
  "version": "0.2.0",
  "description": "URK kernel - canonical kernel lifecycle, explicit runtime state, registries, and event routing",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "test": "yarn build && yarn test:types && node --test tests/*.test.mjs",
    "test:types": "tsc --project tests/types/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "yarn typecheck"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}
