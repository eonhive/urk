{
  "name": "@urk/examples",
  "version": "0.2.0",
  "private": true,
  "description": "URK examples - internal unstable runtime proofs consumed by the public website",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./v02": {
      "types": "./dist/v02/runtime.d.ts",
      "import": "./dist/v02/runtime.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "lint": "yarn typecheck",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@urk/adapters": "workspace:*",
    "@urk/core": "workspace:*",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/three": "^0.184.0",
    "typescript": "^5.3.0"
  }
}
