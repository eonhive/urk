{
  "name": "@urk/examples",
  "version": "0.2.0",
  "private": true,
  "description": "URK examples - internal unstable runtime proofs consumed by the public website",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./motion-widget": {
      "types": "./dist/motion-widget/index.d.ts",
      "import": "./dist/motion-widget/index.js"
    },
    "./selection-details": {
      "types": "./dist/selection-details/mount.d.ts",
      "import": "./dist/selection-details/mount.js"
    },
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./v02": {
      "types": "./dist/v02/runtime.d.ts",
      "import": "./dist/v02/runtime.js"
    },
    "./video-proof": {
      "types": "./dist/video-proof/mount.d.ts",
      "import": "./dist/video-proof/mount.js"
    },
    "./interactive-media": {
      "types": "./dist/interactive-media/mount.d.ts",
      "import": "./dist/interactive-media/mount.js"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "import": "./dist/media/index.js"
    },
    "./experience-showcase": {
      "types": "./dist/experience-showcase/mount.d.ts",
      "import": "./dist/experience-showcase/mount.js"
    },
    "./audio-proof": {
      "types": "./dist/audio-proof/mount.d.ts",
      "import": "./dist/audio-proof/mount.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "lint": "yarn typecheck",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@urk/adapters": "workspace:*",
    "@urk/core": "workspace:*",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/three": "^0.184.0",
    "typescript": "^5.3.0"
  }
}
