{
  "name": "@urk/cli",
  "version": "0.2.0",
  "description": "URK CLI - lightweight developer tooling for scaffolding and inspecting URK projects",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "urk": "./dist/index.js"
  },
  "files": [
    "dist",
    "src/templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "lint": "yarn typecheck",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.17.57",
    "typescript": "^5.3.0"
  },
  "urkTemplateVersions": {
    "core": "^0.2.0",
    "adapters": "^0.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "packageManager": "yarn@3.8.7"
  }
}
